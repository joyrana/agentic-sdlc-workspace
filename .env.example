# Copy to services/api/.env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sdlc:sdlc@localhost:5432/sdlc

# Development sign-in accounts (refused when APP_ENV=production)
DEV_SEED_USERS=true

# Optional: OpenAI-compatible model endpoint, e.g. vLLM serving a Qwen model.
# Leave unset to run rule-based skill strategies (clearly labeled in the UI).
# MODEL_ENDPOINT_URL=http://localhost:8001/v1
# MODEL_ENDPOINT_API_KEY=

# Sandbox backend: namespace (needs root/CAP_SYS_ADMIN for the worker) | docker | none (tests only)
SANDBOX_BACKEND=namespace

# Production deployment stays disabled until explicitly configured and approved.
PRODUCTION_DEPLOY_ENABLED=false
